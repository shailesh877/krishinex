{
  "expo": {
    "name": "KrishiNex",
    "slug": "khetify",
    "version": "1.57.0",
    "orientation": "portrait",
    "icon": "./assets/images/Krishinex App logo PNG.png",
    "scheme": "krishinex",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pasiwaresocial.krishinex",
      "googleServicesFile": "./google-services.json",
      "versionCode": 57,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Krishinex App logo PNG.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d0b9e5e-530c-4a54-84ff-5a62be6ab536"
      }
    },
    "owner": "pasiwaresocial"
  }
}
